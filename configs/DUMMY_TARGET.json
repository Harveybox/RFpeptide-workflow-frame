{
  "target": "DUMMY_TARGET",
  "pilot": "pilot0",
  "remarks": "Demo-only config. Replace with pilot notes, special queue choices, contig rationale, or screening reminders.",
  "cluster_user": "your_cluster_user",
  "scratch_date": "YYYY-MM-DD",
  "project_dir_name": "DUMMY_TARGET_demo",
  "home_project_dir": "$HOME/RFpeptide_demo/DUMMY_TARGET",
  "input_pdb": "$HOME/RFpeptide_demo/DUMMY_TARGET/inputs/dummy_target_clean.pdb",
  "local_input_pdb": "examples/dummy_target_clean.pdb",
  "target_chain": "A",
  "binder_chain": "B",
  "contigs": "A1-3/0 8-16",
  "binder_length": "8-16",
  "rfdiffusion": {
    "hotspot_res": "A2",
    "queue": "your_gpu_queue",
    "gpu_req": "num=1:aff=no",
    "gpu_ncpu": 8,
    "gpu_span": "span[ptile=8]",
    "env_name": "SE3nv",
    "rfdiffusion_dir": "$HOME/RFdiffusion",
    "n_shards": 2,
    "designs_per_shard": 2,
    "diffuser_T": 50
  },
  "proteinmpnn": {
    "queue": "your_cpu_queue",
    "env_name": "proteinmpnn_binder_design",
    "script": "$HOME/dl_binder_design/mpnn_fr/dl_interface_design.py",
    "n_shards": 2,
    "ncpu": 1,
    "resource_req": "",
    "relax_cycles": 4,
    "seqs_per_struct": 1
  },
  "afcyc": {
    "gpu_queue": "your_gpu_queue",
    "cpu_queue": "your_cpu_queue",
    "gpu_req": "num=1:aff=no",
    "gpu_ncpu": 8,
    "gpu_span": "span[ptile=8]",
    "cpu_ncpu": 8,
    "cpu_span": "span[ptile=8]",
    "env_name": "afcycdesign",
    "afcyc_script": "$HOME/RFpeptide_demo/DUMMY_TARGET/3.AfCycDesign/v3/afcyc_predict_batch.py",
    "local_afcyc_script": "examples/scripts/afcyc_predict_batch.py",
    "rmsd_script": "$HOME/RFpeptide_demo/DUMMY_TARGET/3.AfCycDesign/v3/rmsd_from_afcyc.py",
    "local_rmsd_script": "examples/scripts/rmsd_from_afcyc.py",
    "merge_script": "$HOME/RFpeptide_demo/DUMMY_TARGET/3.AfCycDesign/v3/merge_afcyc_csvs.py",
    "local_merge_script": "examples/scripts/merge_afcyc_csvs.py",
    "n_shards": 2,
    "num_recycles": 3,
    "num_models": 1,
    "af_params_dir": "$HOME/dl_binder_design/af2_initial_guess/model_weights/params"
  },
  "pyrosetta": {
    "queue": "your_cpu_queue",
    "env_name": "PyRosettaScore",
    "script": "$HOME/RFpeptide_demo/DUMMY_TARGET/4.PyRosetta/PyRosetta_fullScoring_v4_debug.py",
    "local_script": "examples/scripts/PyRosetta_fullScoring_v4_debug.py",
    "merge_script": "$HOME/RFpeptide_demo/DUMMY_TARGET/4.PyRosetta/merge_pyrosetta_csvs.py",
    "local_merge_script": "examples/scripts/merge_pyrosetta_csvs.py",
    "n_shards": 2,
    "ncpu": 2,
    "resource_req": "",
    "pack_input": true,
    "pack_separated": true,
    "packstat": true
  }
}
